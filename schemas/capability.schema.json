{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handrail capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "application",
    "inputs",
    "outputs",
    "steps",
    "checkpoint",
    "targeting",
    "risk"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "const": "read_savings_balance"
    },
    "version": {
      "const": 1
    },
    "application": {
      "const": {
        "family": "legacy-servicing-demo",
        "binding_version": "1.0"
      }
    },
    "inputs": {
      "const": {
        "member_id": {
          "type": "string",
          "pattern": "^[0-9]{5}$",
          "sensitive": true
        }
      }
    },
    "outputs": {
      "const": {
        "balance": {
          "type": "decimal",
          "scale": 2,
          "sensitive": true
        },
        "currency": {
          "type": "string",
          "enum": ["USD"]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "target", "parameter"],
            "properties": {
              "action": {
                "const": "fill"
              },
              "target": {
                "const": "memberNumber"
              },
              "parameter": {
                "const": "member_id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "target"],
            "properties": {
              "action": {
                "const": "click"
              },
              "target": {
                "enum": ["search", "openMember", "savings", "transfer"]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "target", "output"],
            "properties": {
              "action": {
                "const": "extract"
              },
              "target": {
                "const": "balance"
              },
              "output": {
                "const": "balance"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "target", "output"],
            "properties": {
              "action": {
                "const": "extract"
              },
              "target": {
                "const": "currency"
              },
              "output": {
                "const": "currency"
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["action", "output"],
            "properties": {
              "action": {
                "const": "extract"
              },
              "output": {
                "const": "balance"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["action", "output"],
            "properties": {
              "action": {
                "const": "extract"
              },
              "output": {
                "const": "currency"
              }
            }
          }
        }
      ]
    },
    "checkpoint": {
      "const": "savings_verified"
    },
    "targeting": {
      "const": {
        "strategy": "trusted-binding-reference",
        "binding": "legacy-servicing-demo@1.0"
      }
    },
    "risk": {
      "const": "read_only"
    }
  }
}
