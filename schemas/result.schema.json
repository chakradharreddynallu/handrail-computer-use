{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handrail invocation result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outputs", "step"],
      "properties": {
        "status": {
          "const": "success"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["balance", "currency"],
          "properties": {
            "balance": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            "currency": {
              "const": "USD"
            }
          }
        },
        "artifact": {
          "$ref": "capability.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "step"],
      "properties": {
        "status": {
          "const": "business_outcome"
        },
        "code": {
          "enum": ["member_not_found", "validation_error", "permission_denied"]
        },
        "step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "step", "expected", "observed"],
      "properties": {
        "status": {
          "const": "failure"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": "string"
        },
        "observed": {
          "type": "object"
        }
      }
    }
  ]
}
